# PremiumPulse Environment Configuration
# Copy this file to .env for local overrides

# Operational Mode
PREMIUMPULSE_MODE=SNAPSHOT
PREMIUMPULSE_PORT=8000
PREMIUMPULSE_HOST=0.0.0.0
PREMIUMPULSE_API_KEY=pp-dev-secret-key-98765

# Snowflake Configuration (Optional - Defaults to Offline Snapshot if omitted)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=PP_WH
SNOWFLAKE_DATABASE=PREMIUMPULSE_DB
SNOWFLAKE_SCHEMA=MART
SNOWFLAKE_ROLE=PP_VIEWER

# Databricks Configuration (Optional - For Workflow automation deployment)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=premiumpulse
DATABRICKS_VOLUME=landing_zone

# Groq LLM Configuration (Optional - Used for AI quote explainer chains)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
