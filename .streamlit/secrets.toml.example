# Streamlit Secrets Template for PremiumPulse
# For local development or Streamlit Community Cloud deployment

PREMIUMPULSE_MODE = "SNAPSHOT"
PREMIUMPULSE_API_KEY = "pp-dev-secret-key-98765"

# Optional: Live Snowflake credentials
# SNOWFLAKE_ACCOUNT = "xy12345.us-east-1"
# SNOWFLAKE_USER = "PP_APP_USER"
# SNOWFLAKE_PASSWORD = "your_secure_password"
# SNOWFLAKE_WAREHOUSE = "PP_WH"
# SNOWFLAKE_DATABASE = "PREMIUMPULSE_DB"
# SNOWFLAKE_SCHEMA = "MART"
# SNOWFLAKE_ROLE = "PP_VIEWER"

# Optional: Groq LLM API Key
